  "scope": {
    "product_gate": "A general-purpose coding Harness must be able to inspect an existing repository, change code, and run commands, tests, or a pull-request workflow.",
    "activity_gate": "An official repository or first-party product page must be active on the snapshot date. Archived products and public repositories with no activity in the prior 180 days are excluded.",
    "market_presence_gate": "Include a public implementation with at least 10,000 GitHub stars, or a first-party commercial product with maintained official documentation.",
    "unit": "One named Harness product, not every IDE, CLI, web, mobile, or cloud surface of the same product.",
    "exclusions": "Models and APIs without a Harness, autocomplete-only assistants, app builders that cannot operate on an arbitrary existing repository, libraries/frameworks, archived products, and duplicate product surfaces."
  },
